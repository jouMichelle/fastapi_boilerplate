APP_ENV=development
APP_NAME="FastAPI Boilerplate"
APP_VERSION=0.1.0
APP_DESCRIPTION="A production-ready FastAPI boilerplate"
DEBUG=false
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS 支持 JSON 数组或逗号分隔
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'
CORS_METHODS='["*"]'
CORS_HEADERS='["*"]'
CORS_ALLOW_CREDENTIALS=true

# ===========================================
# 数据库配置（支持分离式配置和直接 URL 配置）
# ===========================================

# --- SQLite 数据库配置 ---
SQLITE_PATH=./data/app.db
# 或者直接配置 URL（可选，优先级更高）
# _SQLITE_URL=sqlite+aiosqlite:///./data/app.db

# --- PostgreSQL 数据库配置 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=fastapi_db
# 或者直接配置 URL（可选，优先级更高）
# _POSTGRES_URL=postgresql+asyncpg://postgres:password@localhost:5432/fastapi_db

# --- MySQL 数据库配置 ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fastapi_db
# 或者直接配置 URL（可选，优先级更高）
# _MYSQL_URL=mysql+aiomysql://root:password@localhost:3306/fastapi_db

# 默认使用的数据库（sqlite | postgres | mysql）
DEFAULT_DATABASE=sqlite

# ===========================================
# Redis 配置
# ===========================================
REDIS_URL="redis://localhost:6379/0"
