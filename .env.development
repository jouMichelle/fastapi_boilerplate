# ===========================================
# 开发环境配置 (.env.development)
# ===========================================
# 使用 SQLite，无需安装数据库服务

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS 支持 JSON 数组或逗号分隔
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'
CORS_METHODS='["*"]'
CORS_HEADERS='["*"]'
CORS_ALLOW_CREDENTIALS=true

# 数据库配置（SQLite - 开发环境推荐）
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"

# Redis（开发环境可选）
# REDIS_URL="redis://localhost:6379/0"
