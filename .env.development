# ===========================================
# 开发环境配置 (.env.development)
# ===========================================
# 使用 SQLite，无需安装数据库服务

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS 支持 JSON 数组或逗号分隔
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'
CORS_METHODS='["*"]'
CORS_HEADERS='["*"]'
CORS_ALLOW_CREDENTIALS=true

# ===========================================
# SQLite 数据库配置（可选）
# ===========================================
SQLITE_PATH=./data/app.db

# ===========================================
# MySQL 数据库配置
# ===========================================
MYSQL_HOST=47.106.21.234
MYSQL_PORT=9201
MYSQL_USER=root
MYSQL_PASSWORD=xhzl&123
MYSQL_DB=maintain

# ===========================================
# PostgreSQL 数据库配置
# ===========================================
POSTGRES_HOST=47.106.21.234
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=xhzl@123
POSTGRES_DB=langgraph_db

